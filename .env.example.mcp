# WAHA MCP Server Configuration Example

# Enable MCP server (default: false)
WAHA_MCP_ENABLED=true

# Standard WAHA configuration
WHATSAPP_API_PORT=3000
WHATSAPP_DEFAULT_ENGINE=WEBJS

# API Authentication
WAHA_API_KEY=your-secret-key-here

